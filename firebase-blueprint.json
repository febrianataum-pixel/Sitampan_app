{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Formulir pendataan jenis barang logistik kebencanaan",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kodeBarang": {
          "type": "string"
        },
        "namaBarang": {
          "type": "string"
        },
        "satuan": {
          "type": "string"
        },
        "harga": {
          "type": "number"
        },
        "kategori": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kodeBarang",
        "namaBarang",
        "satuan",
        "harga",
        "kategori"
      ]
    },
    "InboundEntry": {
      "title": "InboundEntry",
      "description": "Log barang masuk ke gudang logistik",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "productId": {
          "type": "string"
        },
        "jumlah": {
          "type": "number"
        },
        "bulan": {
          "type": "string"
        },
        "tahun": {
          "type": "number"
        },
        "tanggal": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "productId",
        "jumlah",
        "bulan",
        "tahun",
        "tanggal"
      ]
    },
    "OutboundTransaction": {
      "title": "OutboundTransaction",
      "description": "Daftar pengeluaran logistik untuk bantuan bencana",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "penerima": {
          "type": "string"
        },
        "tanggal": {
          "type": "string"
        },
        "alamat": {
          "type": "string"
        },
        "jenisBencana": {
          "type": "string"
        },
        "subJenisBencana": {
          "type": "string"
        },
        "keteranganBencana": {
          "type": "string"
        },
        "items": {
          "type": "array"
        }
      },
      "required": [
        "id",
        "penerima",
        "tanggal",
        "alamat",
        "items"
      ]
    },
    "ArchiveDocument": {
      "title": "ArchiveDocument",
      "description": "Dokumen berita acara dan arsip logistik",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "fileUrl": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "date",
        "fileUrl",
        "fileName"
      ]
    }
  },
  "firestore": {
    "products/{id}": {
      "schema": "Product",
      "description": "Manajemen database barang logistik"
    },
    "inbound/{id}": {
      "schema": "InboundEntry",
      "description": "Log transaksi barang masuk"
    },
    "outbound/{id}": {
      "schema": "OutboundTransaction",
      "description": "Log transaksi barang keluar"
    },
    "documents/{id}": {
      "schema": "ArchiveDocument",
      "description": "Arsip dokumen digital logistik"
    }
  }
}
